{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinical-ratings-api",
  "main": "worker.js",
  "compatibility_date": "2026-03-18",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "RATINGS",
      "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID"
    }
  ]
}
